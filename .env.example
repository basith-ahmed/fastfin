# Application
NODE_ENV=development
BACKEND_PORT=4000
FRONTEND_URL=http://localhost:3000

# PostgreSQL
POSTGRES_DB=FastFin
POSTGRES_USER=FastFin
POSTGRES_PASSWORD=FastFin
DATABASE_URL=postgresql://FastFin:FastFin@localhost:5432/FastFin

# Redis
REDIS_URL=redis://localhost:6379

# PDF storage
PDF_STORAGE_PATH=./storage/pdfs
PDF_TEMP_PATH=./storage/temp
MAX_UPLOAD_MB=50

# OpenAI
OPENAI_API_KEY=
OPENAI_EXTRACTION_MODEL=gpt-5.6-luna
OPENAI_ENTITY_MODEL=gpt-5.6-luna
OPENAI_REASONING_MODEL=gpt-5.6-terra

# Gemini embeddings
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768

# Processing
LLM_MAX_CONCURRENCY=3
LLM_REQUEST_TIMEOUT_MS=60000

FACT_MIN_CONFIDENCE=0.65
EVIDENCE_FUZZY_THRESHOLD=0.92
ENTITY_AUTO_MATCH_THRESHOLD=0.94
CANDIDATE_VECTOR_THRESHOLD=0.62
CANDIDATE_TOP_K=10
RELATION_MIN_CONFIDENCE=0.70
